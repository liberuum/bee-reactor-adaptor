{
  "name": "@liberuum-org/connect",
  "productName": "Powerhouse-Connect-Swarm",
  "version": "6.0.0-dev.163-swarm.23",
  "description": "Powerhouse Connect — fork with Swarm Storage settings (source synced from powerhouse/apps/connect)",
  "main": "dist/index.html",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "files": [
    "dist",
    "scripts",
    "assets",
    "public"
  ],
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/start-connect.d.ts",
      "import": "./dist/start-connect.js"
    },
    "./package.json": "./package.json",
    "./main.js": {
      "source": "./main.tsx",
      "types": "./dist/main.d.ts",
      "import": "./dist/main.js"
    },
    "./assets/*": "./assets/*",
    "./public/*": "./public/*",
    "./style.css": {
      "source": "./style.css",
      "default": "./dist/style.css"
    },
    "./index.html": "./index.html",
    "./vite.config.ts": "./vite.config.ts",
    "./services": {
      "source": "./src/services/index.ts",
      "import": "./src/services/index.ts"
    },
    "./services/*": {
      "source": "./src/services/*.ts",
      "import": "./src/services/*.ts"
    },
    "./components": {
      "source": "./src/components/index.ts",
      "import": "./src/components/index.ts"
    },
    "./components/*": {
      "source": "./src/components/*.ts",
      "import": "./src/components/*.ts"
    },
    "./*": "./*"
  },
  "sideEffects": [
    "./dist/main.js",
    "./dist/start-connect.js",
    "./dist/style.css"
  ],
  "publishConfig": {
    "access": "public"
  },
  "license": "AGPL-3.0-only",
  "author": "powerhouse.inc",
  "repository": {
    "type": "git",
    "url": "https://github.com/powerhouse-inc/powerhouse"
  },
  "bugs": {
    "url": "https://github.com/powerhouse-inc/powerhouse/issues"
  },
  "homepage": "https://github.com/powerhouse-inc/powerhouse#readme",
  "scripts": {
    "tsc": "tsc",
    "lint": "eslint",
    "test": "vitest --run",
    "dev": "vite dev",
    "build": "npm run build:bundle && npm run build:css",
    "build:css": "tailwindcss -i ./style.css -o ./dist/style.css",
    "build:bundle": "tsdown",
    "build:debug": "PH_DEBUG_BUILD=true vite build",
    "preview": "vite preview",
    "cy:open": "cypress open",
    "docker:build": "docker build -f ./Dockerfile --tag connect-test-dev --build-arg TAG=dev .",
    "docker:run": "docker run -it -p 4000:4000 -v $(realpath ../../../monorepo):/monorepo -v $(pwd)/nginx.conf:/etc/nginx/nginx.conf.template -e PH_USE_LOCAL=true -e PH_CONNECT_BASE_PATH=/develop/powerhouse/connect -e PORT=4000 connect-test-dev"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.3.15",
    "@electric-sql/pglite-tools": "0.2.20",
    "@openfeature/core": "1.9.1",
    "@openfeature/web-sdk": "1.6.2",
    "@powerhousedao/config": "6.0.0-dev.163",
    "@powerhousedao/design-system": "6.0.0-dev.163",
    "@powerhousedao/document-engineering": "1.40.1",
    "@powerhousedao/powerhouse-vetra-packages": "6.0.0-dev.163",
    "@powerhousedao/reactor-browser": "6.0.0-dev.163",
    "@powerhousedao/shared": "6.0.0-dev.163",
    "@powerhousedao/vetra": "6.0.0-dev.163",
    "@renown/sdk": "6.0.0-dev.163",
    "@sentry/react": "^10.17.0",
    "document-model": "6.0.0-dev.163",
    "graphql": "16.12.0",
    "graphql-request": "7.4.0",
    "i18next": "^25.5.3",
    "kysely": "0.28.11",
    "kysely-pglite-dialect": "1.2.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-error-boundary": "^4.0.11",
    "react-hotkeys-hook": "^4.6.2",
    "react-i18next": "^16.0.0",
    "react-router-dom": "^6.11.2",
    "tailwind-merge": "3.4.0",
    "usehooks-ts": "^3.1.1"
  },
  "devDependencies": {
    "@tailwindcss/cli": "4.2.2",
    "@tailwindcss/vite": "4.2.2",
    "@types/bun": "1.3.8",
    "@types/node": "25.2.3",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/wicg-file-system-access": "^2023.10.7",
    "@vitejs/plugin-react": "6.0.1",
    "cypress": "^14.5.4",
    "tailwindcss": "4.2.2",
    "typescript": "^5.9.3",
    "tsdown": "0.21.0",
    "vite": "8.0.2",
    "vite-bundle-analyzer": "^1.3.6",
    "vite-plugin-svgr": "4.5.0",
    "vite-tsconfig-paths": "6.1.1"
  }
}
