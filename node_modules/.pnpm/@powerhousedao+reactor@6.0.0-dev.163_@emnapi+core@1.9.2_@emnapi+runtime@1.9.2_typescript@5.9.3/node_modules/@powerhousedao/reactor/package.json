  "dependencies": {
    "uuid": "^11.0.5",
    "kysely": "0.28.11",
    "kysely-pglite-dialect": "1.2.0",
    "@electric-sql/pglite": "0.3.15",
    "@sindresorhus/fnv1a": "3.1.0",
    "@powerhousedao/shared": "6.0.0-dev.163",
    "document-model": "6.0.0-dev.163"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "4.1.1",
    "prettier": "3.8.1",
