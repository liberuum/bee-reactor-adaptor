{
  "name": "zocker",
  "description": "Generate realistic test-data from your Zod-Schemas",
  "version": "3.0.0",
  "author": "Loris Sigrist",
  "license": "MIT",
  "keywords": [
    "mock-data",
    "zod"
  ],
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "repository": {
    "type": "git",
    "url": "https://github.com/LorisSigrist/zocker.git"
  },
  "homepage": "https://zocker.sigrist.dev",
  "devDependencies": {
    "tsdown": "^0.12.9",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4",
    "zod": "^4.0.0"
  },
  "files": [
    "dist"
  ],
  "peerDependencies": {
    "zod": "^3.25.0 || ^4.0.0"
  },
  "dependencies": {
    "@faker-js/faker": "^10.0.0",
    "randexp": "^0.5.3"
  },
  "scripts": {
    "build": "tsdown --dts --format cjs --format esm",
    "test": "vitest --run --passWithNoTests",
    "check": "tsc --noEmit",
    "format": "prettier --write ."
  }
}